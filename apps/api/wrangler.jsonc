{
  "name": "here-moments-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-23",
  // The spec's Zod is most of the bundle; minifying takes it from 800 to 480 KiB.
  "minify": true,
  "observability": { "enabled": true },
  // The independent database for this deployment.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "here-moments",
      "database_id": "9dccb455-3179-415d-92c3-ab540dba304b",
      "migrations_dir": "migrations",
    },
  ],
  // Uploads wait under uploads/ until they publish.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "here-moments-media" }],
  // Where a new place's province, city and district are looked up.
  "vars": {
    "DIVISIONS_URL": "https://geo.datav.aliyun.com/areas_v3/bound",
  },
  // Posts to the channel what an earlier run left, as a write's run past its 30 seconds.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Secrets, set with `wrangler secret put` and in `.dev.vars` locally: API_TOKENS, a
  // comma-separated list of bearer tokens, DEPLOY_HOOK_URL, which a write the site
  // shows calls so the site builds again, MAPBOX_TOKEN, for the trips' routes, and
  // TELEGRAM_BOT_TOKEN, the bot that posts to the channel.
}
